# DeepFakeShield Environment Configuration Template
# Copy this file to backend/.env and configure your values

# Project configuration
PROJECT_NAME=DeepFakeShield
API_V1_STR=/api

# Neon Serverless PostgreSQL Connection String (SSL required)
# Format: postgresql://[user]:[password]@[neon-hostname].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Upload size limits (in bytes, default: 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Server configuration
HOST=127.0.0.1
PORT=8000
